# OpenAI-compatible chat completions (DeepSeek / OpenAI / 通义兼容模式等).
# DeepSeek: create a key at https://platform.deepseek.com/api_keys
#   BASE_URL=https://api.deepseek.com/v1  MODEL=deepseek-chat
#   API_KEY must be a DeepSeek key (usually starts with sk-), NOT an OpenAI sk-proj- key.
# OpenAI: BASE_URL=https://api.openai.com/v1  MODEL=gpt-4o-mini  API_KEY=sk-...
TRIPSENSE_LLM_PROVIDER=openai-compatible
TRIPSENSE_LLM_API_KEY=
TRIPSENSE_LLM_BASE_URL=https://api.deepseek.com/v1
TRIPSENSE_LLM_MODEL=deepseek-chat

# AMap Web Service key. Enables live weather in the API and is also used by
# enrichment/probe scripts. Keep the real value in the process environment.
AMAP_WEB_SERVICE_KEY=
